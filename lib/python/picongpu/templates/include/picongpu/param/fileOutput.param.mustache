    namespace particles::traits {
        /* Restrict the derived attribute {{{typename}}} to the species it is actually
         * defined for, so that `CreateEligible_t` (via `mp_copy_if`) instantiates the
         * solver for only that species instead of every species in `VectorAllSpecies`.
         * The primary `SpeciesEligibleForSolver` is `mp_bool<true>` for all species, and
         * the `FilteredDerivedAttribute` overload forwards the attribute part here, so
         * this single name-keyed specialization narrows the whole combination matrix. */
        template<typename T_Species>
        struct SpeciesEligibleForSolver<T_Species, particleToGrid::derivedAttributes::{{{typename}}}>
        {
            using type = pmacc::mp_bool<
                std::is_same_v<pmacc::traits::GetCTName_t<T_Species>, PMACC_CSTRING("{{{species_name}}}")>>;
        };
    }
{{/species_name}} {{/functor}} {{/derived_fields}} {{/type_openPMD}} {{/output}}


/** @file
 *
 * Definition of frequency space, number of observers, filters, form factors and
 * window functions of the radiation plugin.
 *
 * All values set here determine what the radiation plugin will compute.
 * The observation direction is defined in a seperate file `radiationObserver.param`.
 * On the comand line the plugin still needs to be called for each species the radiation
 * should be computed for.
 */

#pragma once

/**
 * radiation verbose level:
 * 0=nothing, 1=physics, 2=simulation_state, 4=memory, 8=critical
 */
#define PIC_VERBOSE_RADIATION {{#output}}{{#type_radiation}}{{{config.radiation.verbose_level}}}{{/type_radiation}}{{/output}}

#include "picongpu/defines.hpp"
#include "picongpu/particles/manipulators/manipulators.hpp"
#include "picongpu/plugins/radiation/VectorTypes.hpp"

#include <type_traits>

namespace picongpu
{
    namespace plugins
    {
        namespace radiation
        {
          {{#output}}
          {{#type_radiation}}
          {{#config}}
          {{#radiation}}
          {{#frequencies}}
            namespace linear_frequencies
            {
                namespace SI
                {
                    /** mimimum frequency of the linear frequency scale in units of [1/s] */
                    constexpr float_64 omega_min = {{{omega_min}}};
                    /** maximum frequency of the linear frequency scale in units of [1/s] */
                    constexpr float_64 omega_max = {{{omega_max}}};
                } // namespace SI

                /** number of frequency values to compute in the linear frequency [unitless] */
                constexpr unsigned int N_omega = {{{N_omega}}};
            } // namespace linear_frequencies

            namespace log_frequencies
            {
                namespace SI
                {
                    /** mimimum frequency of the linear frequency scale in units of [1/s] */
                    constexpr float_64 omega_min = {{{omega_min}}};
                    /** maximum frequency of the linear frequency scale in units of [1/s] */
                    constexpr float_64 omega_max = {{{omega_max}}};
                } // namespace SI

                /** number of frequency values to compute in the linear frequency [unitless] */
                constexpr unsigned int N_omega = {{{N_omega}}};
            } // namespace log_frequencies

            namespace frequencies_from_list
            {
            {{#type_frequencies_from_list}}
                constexpr char const* listLocation = {{{list_location}}};
            {{/type_frequencies_from_list}}
            {{^type_frequencies_from_list}}
                constexpr char const* listLocation = "path/to/frequencies";
            {{/type_frequencies_from_list}}

                constexpr unsigned int N_omega = {{{N_omega}}};
            } // namespace frequencies_from_list

            /** selected mode of frequency scaling:
             *
             * options:
             * - linear_frequencies
             * - log_frequencies
             * - frequencies_from_list
             */
            namespace radiation_frequencies =
            {{#type_linear_frequencies}}
            linear_frequencies
            {{/type_linear_frequencies}}
            {{#type_log_frequencies}}
            log_frequencies
            {{/type_log_frequencies}}
            {{#type_frequencies_from_list}}
            frequencies_from_list
            {{/type_frequencies_from_list}};

          {{/frequencies}}

            namespace radiationNyquist
            {
                /** Nyquist factor: fraction of the local Nyquist frequency above which the spectra is set to zero
                 * should be in (0, 1).
                 */
                constexpr float_32 NyquistFactor = {{{nyquist_factor}}};
            } // namespace radiationNyquist

            ///////////////////////////////////////////////////


            /** correct treatment of coherent and incoherent radiation from macro particles
             *
             * Choose different form factors in order to consider different particle shapes for radiation
             *  - radFormFactor_CIC_3D ... CIC charge distribution
             *  - radFormFactor_TSC_3D ... TSC charge distribution
             *  - radFormFactor_PCS_3D ... PCS charge distribution
             *  - radFormFactor_CIC_1Dy ... only CIC charge distribution in y
             *  - radFormFactor_Gauss_spherical ... symmetric Gauss charge distribution
             *  - radFormFactor_Gauss_cell ... Gauss charge distribution according to cell size
             *  - radFormFactor_incoherent ... only incoherent radiation
             *  - radFormFactor_coherent ... only coherent radiation
             */
            namespace radFormFactor_CIC_3D
            {
            }

            namespace radFormFactor_TSC_3D
            {
            }

            namespace radFormFactor_PCS_3D
            {
            }

            namespace radFormFactor_CIC_1Dy
            {
            }

            namespace radFormFactor_Gauss_spherical
            {
            }

            namespace radFormFactor_Gauss_cell
            {
            }

            namespace radFormFactor_incoherent
            {
            }

            namespace radFormFactor_coherent
            {
            }

            namespace radFormFactor = radFormFactor_{{{form_factor}}};

            ///////////////////////////////////////////////////////////


            namespace parameters
            {
                /** number of observation directions */
                constexpr unsigned int N_observer = {{{observer.N_observer}}};

            } // namespace parameters

            /** select particles for radiation
             *
             * For every species that takes part in the radiation calculation
             * (i.e. every species that carries the `radiationMask` attribute)
             * a mask functor is rendered that writes the filter's decision
             * into the particle's `radiationMask` attribute:
             *
             * - species wrapped in a PICMI particle filter are masked by the
             *   expression of that filter (see the
             *   `<species>_<filter>MaskFunctor` structs below)
             *
             * `RadiationParticleFilter` selects the matching mask manipulator
             * for a given species.
             */

            {{#species}}
            {{#type_filtered}}
            /** select particles of species `{{{species_name}}}` for radiation
             *
             * Evaluates the particle filter `{{{filter_name}}}` and stores its
             * result in the `radiationMask` attribute of the particle.
             */
            struct {{{species_name}}}_{{{filter_name}}}MaskFunctor
            {
                static constexpr char const* name = "{{{species_name}}}_{{{filter_name}}}MaskFunctor";

                {{#functor.rng_info}}
                template< typename T_Rng, typename T_Particle >
                HDINLINE void operator()( T_Rng& rng, T_Particle& particle )
                {
                    using RNGType = typename std::remove_cvref_t<decltype(rng.m_rng)>;
                {{/functor.rng_info}}
                {{^functor.rng_info}}
                template<typename T_Particle>
                HDINLINE void operator()(
                    {{#functor.needs_total_position}}
                    DataSpace< simDim > const & particleOffsetToTotalOrigin,
                    {{/functor.needs_total_position}}
                    T_Particle& particle
                )
                {
                {{/functor.rng_info}}
                    {{#functor.functor_preamble}}
                    {{{statement}}}
                    {{/functor.functor_preamble}}
                    particle[picongpu::radiationMask_] = {{{functor.functor_expression}}};
                }
            };

            {{/type_filtered}}
            {{/species}}

            using picongpu::particles::filter::random_number;

            namespace detail
            {
                /** select the mask manipulator for a species
                 *
                 * One full specialization is emitted per species wrapped in a
                 * PICMI particle filter. The primary template is therefore only
                 * instantiated for a misconfigured species (a `radiationMask`
                 * attribute without a matching filter).
                 */
                template<typename T_Species>
                struct RadiationParticleFilterFor
                {
                    static_assert(
                        !std::is_same_v<T_Species, T_Species>,
                        "radiation: the species carries the radiationMask attribute but no "
                        "particle filter is defined for it; wrap the species in a PICMI "
                        "particle filter");
                };

            {{#species}}
            {{#type_filtered}}
                template<>
                struct RadiationParticleFilterFor<{{{typename}}}>
                {
                    using type =
                        {{#functor.rng_info}}
                        picongpu::particles::manipulators::generic::FreeRng<
                            {{{species_name}}}_{{{filter_name}}}MaskFunctor,
                            {{{functor.rng_info.typename}}}< {{{functor.rng_info.return_type}}} >
                        >;
                        {{/functor.rng_info}}
                        {{^functor.rng_info}}
                        {{#functor.needs_total_position}}
                        picongpu::particles::manipulators::unary::FreeTotalCellOffset<
                            {{{species_name}}}_{{{filter_name}}}MaskFunctor
                        >;
                        {{/functor.needs_total_position}}
                        {{^functor.needs_total_position}}
                        picongpu::particles::manipulators::generic::Free<
                            {{{species_name}}}_{{{filter_name}}}MaskFunctor
                        >;
                        {{/functor.needs_total_position}}
                        {{/functor.rng_info}}
                };

            {{/type_filtered}}
            {{/species}}
            } // namespace detail

            /** filter to (de)select particles for the radiation calculation
             *
             * to activate the filter:
             *   - add the attribute `radiationMask` to the particle species
             *     (PyPIConGPU does this automatically for filtered species)
             */
            struct RadiationParticleFilter
            {
                template<typename T_SpeciesType>
                struct apply
                {
                    using type = typename detail::RadiationParticleFilterFor<T_SpeciesType>::type;
                };
            };

            //////////////////////////////////////////////////


            /** add a window function weighting to the radiation in order
             * to avoid ringing effects from sharpe boundaries
             * default: no window function via `radWindowFunctionNone`
             *
             * Choose different window function in order to get better ringing reduction
             * radWindowFunctionTriangle
             * radWindowFunctionHamming
             * radWindowFunctionTriplett
             * radWindowFunctionGauss
             * radWindowFunctionNone
             */
            namespace radWindowFunctionTriangle
            {
            }

            namespace radWindowFunctionHamming
            {
            }

            namespace radWindowFunctionTriplett
            {
            }

            namespace radWindowFunctionGauss
            {
            }

            namespace radWindowFunctionNone
            {
            }

            namespace radWindowFunction = radWindowFunction{{{window_function}}};
        {{/radiation}}
        {{/config}}
        {{/type_radiation}}
        {{/output}}
        } // namespace radiation
    } // namespace plugins
} // namespace picongpu

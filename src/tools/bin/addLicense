#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2013-2024 Axel Huebl, Rene Widera
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Add a REUSE SPDX header to a file.
#
# Usage:
#   [PROJECT_NAME=PMacc] addLicense FILE...
#
# The header is generated by the official 'reuse' tool (pip install reuse),
# so the result is REUSE-compliant by construction:
#   - copyright: all authors from 'git log --follow' (with the historical
#     alias renames below), falling back to 'PIConGPU contributors' for
#     files without history
#   - year: current ISO year
#   - license: GPL-3.0-or-later, or 'GPL-3.0-or-later OR LGPL-3.0-or-later'
#     with PROJECT_NAME=PMacc
#   - comment style: C block comments for C-family sources (matching the
#     tree), '#' comments for scripts, configs, and documentation; the
#     header layout is the 'reuse annotate' default template
#
# Files that already carry a header are left untouched (--skip-existing).
# Text extensions unknown to 'reuse' ('.cfg', '.gitignore', '.tpl') are
# annotated with '#' comments (the tree convention for those files); files
# without a comment syntax (images, .json, ...) get a '<file>.license'
# sidecar. A file that cannot be annotated is skipped with a warning so
# the remaining files are still processed (the script exits non-zero if
# any file was skipped). PEP 263 coding lines are kept on line 1/2 of
# '.py' files.

set -e

rename="s/psychocoder/Rene Widera/g;
    s/rp6038/Richard Pausch/g;
    s/fschmitt/Felix Schmitt/g;
    s/ahuebl/Axel Huebl/g;
    s/heiko/Heiko Burau/g;
    s/steinigk/Klaus Steiniger/g;
    s/ben_schneider/Benjamin Schneider/g;
    s/whoenig/Wolfgang Hoenig/g;
    s/rdietric/Robert Dietric/g;
    s/phoenixloe/Florian Berninger/g;
    s/helma/Anton Helm/g;
    s/wf5/Wen Fu/g;
    s/bussmann/Michael Bussmann/g
    "

command -v reuse >/dev/null 2>&1 || {
    echo "addLicense: the 'reuse' CLI is required (pip install reuse)" >&2
    exit 1
}

status=0

for fileName in "$@"; do
    [ -n "$fileName" ] || continue

    if [ ! -f "$fileName" ]; then
        echo "addLicense: no such file: $fileName" >&2
        exit 1
    fi

    case "${PROJECT_NAME:-PIConGPU}" in
    PMacc) license="GPL-3.0-or-later OR LGPL-3.0-or-later" ;;
    *) license="GPL-3.0-or-later" ;;
    esac

    author=$(git log --follow --pretty=format:%an -- "$fileName" 2>/dev/null | sort | uniq | sed "$rename" | uniq | tr "\n" "," | sed 's/,$//g' | sed 's/,/, /g')
    [ -n "$author" ] || author="PIConGPU contributors"
    year=$(date +%G)

    case "$fileName" in
    *.c | *.cc | *.cpp | *.cxx | *.cu | *.cuh | *.h | *.hh | *.hpp | *.hxx | *.tpp | *.def | *.kernel | *.loader | *.unitless | *.param | *.param.mustache)
        style=(--style c)
        ;;
    *.cfg | *.gitignore | *.tpl)
        # text files with '#' comments whose extension 'reuse' does not
        # know; the tree convention for those files is '#' comments
        style=(--style python)
        ;;
    *)
        # python-style '#' for *.sh, *.py, *.toml, CMakeLists.txt, ... and
        # '..' for *.rst are auto-detected by 'reuse'; files without a
        # comment syntax (images, .json, ...) get a '<file>.license'
        # sidecar
        style=()
        ;;
    esac

    # PEP 263: 'reuse annotate' inserts the header before a coding
    # declaration on line 1/2, pushing it out of its recognised position.
    # Remember the line, then move it back after annotating.
    coding_pos=0
    coding_line=""
    case "$fileName" in
    *.py)
        if sed -n '1p' "$fileName" | grep -q '^#!' \
            && sed -n '2p' "$fileName" | grep -qE '^[ \t]*#.*coding[:=]'; then
            coding_pos=2
        elif sed -n '1p' "$fileName" | grep -qE '^[ \t]*#.*coding[:=]'; then
            coding_pos=1
        fi
        ;;
    esac
    if [ "$coding_pos" -gt 0 ]; then
        coding_line=$(sed -n "${coding_pos}p" "$fileName")
    fi

    if ! reuse annotate --skip-existing --year "$year" --copyright "$author" \
        --license "$license" "${style[@]}" "$fileName"; then
        echo "addLicense: skipped '$fileName': 'reuse annotate' failed; remaining files continue" >&2
        status=1
        continue
    fi

    if [ "$coding_pos" -gt 0 ]; then
        newpos=$(awk -v l="$coding_line" '$0==l {print NR; exit}' "$fileName")
        sed -i "${newpos}d" "$fileName"
        sed -i "${coding_pos}i\\
$coding_line" "$fileName"
    fi
done

exit $status
